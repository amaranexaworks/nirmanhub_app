{
  "name": "nirmaan-backend",
  "version": "1.0.0",
  "description": "Nirmaan / ANRIX Construction Network — backend API. DB-driven RBAC, roles, departments, navigation menus. JWT + session auth. Follows the WMS-web server architecture.",
  "private": true,
  "main": "nodeapp.ts",
  "scripts": {
    "start": "cross-env TS_NODE_TRANSPILE_ONLY=true ts-node --transpileOnly nodeapp.ts",
    "start:prod": "cross-env NODE_ENV=production node dist/nodeapp.js",
    "dev": "cross-env TS_NODE_TRANSPILE_ONLY=true nodemon --ext ts,js,json --watch . --ignore node_modules --exec ts-node nodeapp.ts",
    "build": "tsc",
    "keys": "node scripts/generate-keys.js",
    "gen:secrets": "node scripts/gen-secrets.js",
    "admin:password": "node scripts/set-admin-password.js",
    "db:migrate": "cross-env TS_NODE_TRANSPILE_ONLY=true ts-node db/run.ts migrate",
    "db:seed": "cross-env TS_NODE_TRANSPILE_ONLY=true ts-node db/run.ts seed",
    "db:reset": "cross-env TS_NODE_TRANSPILE_ONLY=true ts-node db/run.ts reset",
    "db:setup": "npm run keys && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "rate-limit-redis": "^6.0.0",
    "redis": "^6.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.8",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
