{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["nodeapp.ts", "api/**/*", "config/**/*", "utils/**/*", "initialize/**/*", "db/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
