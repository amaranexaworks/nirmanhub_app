# ─────────────────────────────────────────────────────────────
# Nirmaan Backend — environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4300
APP_ENV=dev

# ── PostgreSQL ──
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=nirmaan
PG_SCHEMA=nirmaan
# Per-instance pool. Size ≈ Postgres max_connections ÷ number of API instances.
# 30 is a sane default for a single instance; lower it if you run many instances.
PG_MAX_POOL=30
PG_MIN_POOL=2
# Set true for any managed Postgres (RDS/Cloud SQL/Neon/…) — enables TLS.
PG_SSL=false

# ── Secrets to ROTATE per environment ──
# Generate strong values with `npm run gen:secrets` and paste them here. The server
# REFUSES to boot in production while any of these are left at the placeholder value.
#
# ── Session (express-session + connect-pg-simple) ──
# PRODUCTION: 32+ random chars (`openssl rand -base64 48` or `npm run gen:secrets`).
SESSION_SECRET=change-me-in-production-a-long-random-string
SESSION_TABLE=user_session_t

# ── JWT (RS256; keys generated by `npm run keys`) ──
# PRODUCTION: set a unique passphrase, THEN regenerate the keypair so the key file
# matches it: `npm run keys -- --force`. Boot fails if the key can't be decrypted
# with this passphrase, or (in production) if it's still the default below.
JWT_PRIVATE_KEY_PASSPHRASE=nirmaan@secret
JWT_AUDIENCE=NIRMAAN_APP
JWT_EXPIRES_IN=4h

# Also rotate the seeded admin password before production: the boot guard refuses to
# start while phone 9999900000 still uses 'nirmaan123'. Set one with:
#   npm run admin:password -- "<new-strong-password>"

# ── Social sign-in (Google / Apple) ──
# When set, /auth/social REQUIRES a valid id_token for that provider and verifies
# it server-side (signature + audience + issuer). Leave blank in dev to allow the
# simulated email-only flow. GOOGLE_CLIENT_ID = your OAuth 2.0 Web client id;
# APPLE_CLIENT_ID = your Services ID (aud claim in Apple id_tokens).
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── OTP ──
# In development, the OTP is returned in the API response and logged.
# In production, wire OTP_PROVIDER to an SMS gateway.
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true
OTP_DEV_FIXED=1234

# ── File uploads (stored on disk as <UPLOAD_DIR>/YYYY/MM/<uuid>.<ext>) ──
# Only the relative path is saved in the DB. In production point UPLOAD_DIR at a
# persistent, backed-up volume (or a mounted object-storage gateway).
# AUTOSCALE: local disk is NOT shared across instances (a file written on one node
# 404s on another). When running multiple instances, set UPLOAD_DIR to a SHARED
# mounted volume (NFS / AWS EFS / GCP Filestore) that every instance mounts at the
# same path. (A native S3/GCS driver is a later upgrade.)
UPLOAD_DIR=
UPLOAD_MAX_BYTES=10485760

# ── CORS (comma-separated origins; * allows all in dev) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:8100,capacitor://localhost,http://localhost

# ── Redis (rate-limiting store) ──
# OPTIONAL for a single instance (falls back to in-memory). REQUIRED when running more
# than one API instance behind a load balancer, so the rate limits are shared/global
# instead of per-process. Example: redis://:password@host:6379
REDIS_URL=
